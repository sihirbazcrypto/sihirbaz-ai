/**
 * Sihirbaz AI Cloudflare Worker configuration
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sihirbaz-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./public"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "sihirbaz_ai_db",
      "database_name": "sihirbaz-ai-db",
      "database_id": "b6fe8f4f-0d28-4f8b-a1ac-97fe853b9710",
      "migrations_dir": "migrations"
    }
  ]

}