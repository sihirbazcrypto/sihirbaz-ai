/**
 * Sihirbaz AI Cloudflare Worker configuration
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sihirbaz-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./public"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
